# Firebase Configuration
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789
REACT_APP_FIREBASE_APP_ID=your-app-id

# Firebase Functions URL (replace YOUR_PROJECT_ID with your actual Firebase project ID)
REACT_APP_FUNCTIONS_URL=https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net

# Cloudflare Configuration (for client-side display only, NOT for API calls)
# DO NOT use these for uploads - uploads go through Firebase Functions
REACT_APP_CF_CUSTOMER_SUBDOMAIN=customer-egd8wletnhjj8i2u

# IMPORTANT SECURITY NOTE:
# - NEVER commit real API tokens to git
# - Cloudflare API credentials are stored in Firebase Functions config, not here
# - To set Firebase Functions config: firebase functions:config:set cloudflare.api_token="your_token"
