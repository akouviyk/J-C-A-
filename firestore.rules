rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Main content collection - American Paradise Vault
    match /americanparadisevault/{docId} {
      // Anyone can read content (public gallery)
      allow read: if true;
      
      // Authenticated users can create new content
      allow create: if request.auth != null
        && request.resource.data.createdBy.uid == request.auth.uid
        && request.resource.data.status == 'active';
      
      // Only content owner can update their own content
      allow update: if request.auth != null 
        && request.auth.uid == resource.data.createdBy.uid
        && request.resource.data.createdBy.uid == resource.data.createdBy.uid; // Prevent changing ownership
      
      // Only content owner can delete their own content
      allow delete: if request.auth != null 
        && request.auth.uid == resource.data.createdBy.uid;
    }
    
    // User profiles (for future Phase 2 implementation)
    match /users/{userId} {
      // Anyone can read public profiles
      allow read: if true;
      
      // Users can only write to their own profile
      allow create, update: if request.auth != null 
        && request.auth.uid == userId;
      
      // Users can delete their own profile
      allow delete: if request.auth != null 
        && request.auth.uid == userId;
    }
    
    // Contributions collection (legacy - can be removed after migration)
    match /contributions/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Likes/Favorites collection (for Phase 2)
    match /likes/{docId} {
      allow read: if true;
      
      // Users can like/unlike
      allow create, delete: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }
    
    // Comments collection (for Phase 2)
    match /comments/{docId} {
      allow read: if true;
      
      // Users can create comments
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      
      // Users can update/delete their own comments
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }
  }
}
